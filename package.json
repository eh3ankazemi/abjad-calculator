{
  "name": "abjad-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "format": "prettier --write \"src\"",
    "prebuild": "node scripts/generate-seo.mjs",
    "build": "next build",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:build": "powershell -ExecutionPolicy Bypass -File ./build-android.ps1",
    "package-update": "bun update -i",
    "package-update-yarn": "yarn upgrade --latest"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "next": "^16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
